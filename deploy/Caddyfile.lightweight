{
  https_port 18443
  admin off
  auto_https disable_redirects
  servers {
    protocols h1 h2
  }
}
https://{$API_HOST}:18443 {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy api:3001
}
